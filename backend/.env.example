# backend/.env 로 복사해서 실제 값 채우기 (.env는 커밋되지 않음)
#
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 에서 발급
# - 애플리케이션 유형: 웹 애플리케이션
# - 승인된 리디렉션 URI: http://localhost:8080/api/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MySQL (docker compose가 이 값으로 컨테이너를 만들고, Spring이 같은 값으로 접속한다)
# DB_PASSWORD / DB_ROOT_PASSWORD 는 로컬에서만 쓸 임의의 값을 직접 정할 것. 비어 있으면 compose가 실행되지 않는다
DB_HOST=localhost
DB_PORT=3306
DB_NAME=qating
DB_USER=qating
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Claude API (POST /qa-issues/parse) — https://platform.claude.com 에서 발급. 비어 있으면 parse가 502로 실패한다
ANTHROPIC_API_KEY=

# Figma 동기화(POST /figma/sync) — Figma > Settings > Personal access tokens 에서 발급(파일 읽기 권한)
FIGMA_ACCESS_TOKEN=
