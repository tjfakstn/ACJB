# backend/.env 로 복사해서 실제 값 채우기 (.env는 커밋되지 않음)
#
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 에서 발급
# - 애플리케이션 유형: 웹 애플리케이션
# - 승인된 리디렉션 URI: http://localhost:8080/api/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MySQL (docker compose가 이 값으로 컨테이너를 만들고, Spring이 같은 값으로 접속한다)
# DB_PASSWORD / DB_ROOT_PASSWORD 는 로컬에서만 쓸 임의의 값을 직접 정할 것. 비어 있으면 compose가 실행되지 않는다
DB_HOST=localhost
DB_PORT=3306
DB_NAME=qating
DB_USER=qating
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Claude API (POST /qa-issues/parse) — https://platform.claude.com 에서 발급. 비어 있으면 parse가 502로 실패한다
ANTHROPIC_API_KEY=

# 재검증 범위 제안(POST /qa-issues/{id}/recheck-suggestions)의 임베딩 — https://dashboard.voyageai.com 에서 발급
# 비어 있으면 임베딩을 만들지 않고, 제안 요청은 502(SUGGESTION_FAILED)로 실패한다. LLM은 위 ANTHROPIC_API_KEY를 같이 쓴다
VOYAGE_API_KEY=

# Figma 동기화(POST /figma/sync) — Figma > Settings > Personal access tokens 에서 발급(파일 읽기 권한)
FIGMA_ACCESS_TOKEN=

# 초대 메일(Gmail SMTP) — 팀 공용 Gmail 계정 주소와 "앱 비밀번호"(구글 계정 > 보안 > 2단계 인증 > 앱 비밀번호)
# 비어 있으면 메일을 보내지 않고, 초대받은 사람은 로그인 후 앱 안 초대함에서 수락한다
MAIL_USERNAME=
MAIL_PASSWORD=

# 단일 컴포넌트 scan — 로컬 프론트(localhost:5173) 화면을 비교하려면 로컬에서만 true. 배포 서버에서는 넣지 않는다(내부망 접근 차단)
# 브라우저는 처음 한 번 ./gradlew playwrightInstall 로 설치
SCAN_ALLOW_LOCALHOST=
