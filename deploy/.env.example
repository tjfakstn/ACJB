# deploy/.env 로 복사해 채운다(커밋 금지). 서버에서만 둔다
#
# 접속 도메인(DNS A 레코드가 이 서버 IP를 가리켜야 HTTPS 인증서가 나온다)
DOMAIN=qating.example.com
# 프론트·API 주소(로그인 후 이동, 초대 메일 링크, CORS). https://{DOMAIN}
APP_BASE_URL=https://qating.example.com
APP_CORS_ORIGINS=https://qating.example.com
SESSION_COOKIE_SECURE=true

# Google OAuth — Google Cloud 콘솔 "승인된 리디렉션 URI"에 https://{DOMAIN}/api/v1/auth/callback/google 추가
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MySQL(컨테이너 안에서만 쓴다) — 로컬과 다른 긴 임의 값
DB_NAME=qating
DB_USER=qating
DB_PASSWORD=
DB_ROOT_PASSWORD=

# 외부 API(backend/.env.example 설명과 같다)
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
FIGMA_ACCESS_TOKEN=
# 소유자 Figma 토큰 암호화 키(Base64 32바이트, openssl rand -base64 32) — 바꾸면 저장된 토큰을 못 풀어 소유자가 다시 넣어야 한다
FIGMA_TOKEN_KEY=
GITHUB_TOKEN=
MAIL_USERNAME=
MAIL_PASSWORD=

# 사용량 한도(SPEC AC36, 2026-11-11) — 선택. 키를 아예 쓰지 않으면 기본값(괄호), 0이면 그 한도를 끈다.
# 빈 값(KEY=)으로 두면 서버가 뜨지 않으니 바꿀 때만 앞의 #을 지우고 숫자를 넣는다
# LIMIT_PROJECTS_PER_OWNER=   # 사용자가 소유한 프로젝트 수(3)
# LIMIT_ANALYSIS_PER_DAY=   # 프로젝트마다 최근 24시간 비교 분석 시작 수, 실패 포함(5)
# LIMIT_FIRST_QA_PER_DAY=   # 첫 QA(5)
# LIMIT_RE_QA_PER_DAY=   # Re-QA(10)
# LIMIT_PARSE_PER_DAY=   # AI 문장 정리(100)
# LIMIT_SUGGESTIONS_PER_DAY=   # 재검증 범위 제안(50)
# LIMIT_INVITATIONS_PER_DAY=   # 초대 메일, 재전송 포함(30)
# JOBS_HEAVY_CONCURRENCY=   # 비교 분석·첫 QA·Re-QA 동시 실행 수(2)
# BROWSER_MAX_CONCURRENT=   # 서버 크로미움 동시 실행 수(2)
# 백엔드 컨테이너 메모리 상한(기본 5g) — JVM 힙은 이 값의 60%
# BACKEND_MEM_LIMIT=