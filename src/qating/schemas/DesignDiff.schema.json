{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DesignDiff",
  "description": "Figma 프레임과 실제 배포 화면을 대조해 발견된 스타일/레이아웃 차이 (초안 v0.1)",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "project_id": { "type": "string" },
    "scan_id": { "type": "string" },
    "frame_id": { "type": "string", "description": "Figma 프레임/노드 id" },
    "frame_name": { "type": "string" },
    "target_url": { "type": "string" },
    "diff_type": {
      "type": "string",
      "enum": ["color", "typography", "spacing", "radius", "shadow", "layout", "text_content", "other"]
    },
    "property": { "type": "string", "description": "예: background-color, font-weight" },
    "expected_value": { "type": "string", "description": "Figma 기준값" },
    "actual_value": { "type": "string", "description": "실제 구현 값" },
    "severity": { "type": "string", "enum": ["critical", "major", "minor"] },
    "screenshot_before_url": { "type": "string", "description": "Figma 캡처" },
    "screenshot_after_url": { "type": "string", "description": "실제 화면 캡처" },
    "status": { "type": "string", "enum": ["open", "ignored", "resolved"], "default": "open" },
    "detected_by": { "type": "string", "enum": ["auto", "manual"], "default": "auto" },
    "detected_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "project_id", "frame_id", "diff_type", "property", "expected_value", "actual_value", "severity", "status", "detected_at"]
}
