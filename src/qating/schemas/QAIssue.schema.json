{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QAIssue",
  "description": "QA 중 발견되어 등록·전달되는 수정 요청 한 건 (docs/ontology.yaml QAIssue, docs/SPEC.md v0.2)",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "project_id": { "type": "string" },
    "description": { "type": "string", "minLength": 1, "description": "자유서술. 텍스트만으로는 재현이 안 되는 경우가 많아 아래 필드들이 필수" },
    "screen_location": { "type": "string", "minLength": 1, "description": "어느 화면의 어느 요소인지" },
    "repro_steps": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "platform_scope": { "type": "string", "enum": ["common", "aos", "ios"], "description": "이슈 분류용(common=AOS·iOS 모두). 실제 발생 환경은 environment" },
    "environment": {
      "type": "object",
      "properties": {
        "platform": { "type": "string", "enum": ["aos", "ios", "web"] },
        "device": { "type": "string" },
        "browser": { "type": "string" },
        "deploy_stage": { "type": "string", "enum": ["local", "staging", "production"] }
      }
    },
    "screenshots": { "type": "array", "items": { "type": "string" } },
    "figma_link": { "type": ["string", "null"] },
    "style_mismatch": {
      "oneOf": [{ "$ref": "StyleMismatch.schema.json" }, { "type": "null" }],
      "description": "연결된 스타일 차이. 수동 등록이면 null"
    },
    "status": {
      "type": "string",
      "enum": ["needs_check", "in_progress", "fixed", "needs_recheck", "resolved"],
      "default": "needs_check",
      "description": "확인 필요 → (수정 중, 건너뛸 수 있음) → 조치 완료 → (재검증 pass) 해결 완료 / (fail) 재확인 필요 → 수정 중·조치 완료 (in_progress 2026-11-07)"
    },
    "source": { "type": "string", "enum": ["manual", "first_qa"], "default": "manual", "description": "manual=사람이 등록, first_qa=첫 QA가 근거로 자동 저장(SPEC AC23)" },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["needs_check", "in_progress", "fixed", "needs_recheck", "resolved"] },
          "changed_by": { "type": "string" },
          "changed_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "assigned_team": { "type": ["string", "null"], "enum": ["planner", "designer", "frontend", "backend", null], "description": "담당 팀(프로젝트 역할과 같은 값, 2026-11-08)" },
    "reported_by": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "project_id", "description", "screen_location", "repro_steps", "platform_scope", "status", "reported_by", "created_at"]
}
